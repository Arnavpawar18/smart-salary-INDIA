# Root Environment Variables for SmartSalary (Phase 1 Baseline)

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Configuration
PROJECT_NAME="SmartSalary India"
API_V1_STR="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database Configuration (PostgreSQL 18+)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smartsalary
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smartsalary

# Test Database Configuration
POSTGRES_TEST_DB=smartsalary_test
DATABASE_URL_TEST=postgresql+psycopg://postgres:postgres@localhost:5432/smartsalary_test

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
